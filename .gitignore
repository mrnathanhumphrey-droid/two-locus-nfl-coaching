# Data: only the frozen inputs are committed. Everything else under data/ is staged or built by a run.
data/*
!data/frozen/

# Results: only the expected outputs are committed. results/<mode>/ is written by each run.
results/*
!results/expected/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*~
.ipynb_checkpoints/
*.log
